<%- include('partials/head') %>
<div class="auth-wrap">
  <div class="auth-art">
    <span class="bubble b1"></span><span class="bubble b2"></span>
    <%- include('partials/brand') %>
    <div>
      <span class="eyebrow" style="color:var(--sky)"><%= t('login.eyebrow') %></span>
      <h2 style="margin-top:18px"><%= t('login.art') %></h2>
    </div>
    <p class="small" style="color:#C9BAB8;margin:0"><%= t('login.artFoot') %></p>
  </div>
  <div class="auth-form">
    <%- include('partials/lang-switch') %>
    <form method="post" action="/login">
      <h1><%= t('login.welcome') %></h1>
      <p class="muted"><%= t('login.lead') %></p>
      <% if (error) { %><div class="flash flash-error" role="alert"><%= error %></div><% } %>
      <input type="hidden" name="next" value="<%= next %>">
      <div class="field">
        <label for="username"><%= t('login.username') %></label>
        <input id="username" type="text" name="username" autocomplete="username" required autofocus>
      </div>
      <div class="field">
        <label for="password"><%= t('login.password') %></label>
        <input id="password" type="password" name="password" autocomplete="current-password" required>
      </div>
      <button class="btn btn-lg btn-block" type="submit"><%= t('login.submit') %> <span class="arrow">→</span></button>
      <p class="small muted" style="margin-top:18px;text-align:center"><a href="/"><%= t('login.back') %></a></p>
    </form>
  </div>
</div>
</body>
</html>
