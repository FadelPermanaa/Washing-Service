<%- include('partials/head') %>
<header class="site-nav">
  <div class="container">
    <%- include('partials/brand') %>
    <nav class="site-links" aria-label="Main">
      <a href="#services"><%= t('site.services') %></a>
      <a href="#pricing"><%= t('site.pricing') %></a>
      <a href="#how"><%= t('site.how') %></a>
      <a href="#status"><%= t('site.status') %></a>
      <%- include('partials/lang-switch') %>
      <a class="btn btn-sm" href="/login"><%= t('site.staffLogin') %> <span class="arrow">→</span></a>
    </nav>
  </div>
</header>

<section class="hero">
  <div class="container hero-grid">
    <div>
      <span class="eyebrow"><%= t('brand.tagline') %></span>
      <h1><%- t('hero.title') %></h1>
      <p class="lead"><%= t('hero.lead') %></p>
      <div class="hero-cta">
        <a class="btn btn-lg" href="#pricing"><%= t('hero.ctaPrices') %> <span class="arrow">→</span></a>
        <a class="btn btn-lg btn-ghost" href="#status"><%= t('hero.ctaStatus') %></a>
      </div>
    </div>
    <div class="hero-card" aria-label="<%= t('hero.cardAria') %>">
      <h3><%= t('hero.cardTitle') %></h3>
      <p class="small" style="color:#C9BAB8"><%= t('hero.cardSub') %></p>
      <div class="q-row"><span class="plate">B 1234 XYZ</span><span class="small"><%= t('hero.sample1') %></span><span class="step s3"><%= t('status.done') %></span></div>
      <div class="q-row"><span class="plate">D 88 KLM</span><span class="small"><%= t('hero.sample2') %></span><span class="step s2"><%= t('status.washing') %></span></div>
      <div class="q-row"><span class="plate">F 4521 AB</span><span class="small"><%= t('hero.sample3') %></span><span class="step s1"><%= t('status.waiting') %></span></div>
      <div class="hero-float"><%= t('hero.float') %></div>
    </div>
  </div>
</section>

<div class="marquee" aria-hidden="true">
  <div class="marquee-track">
    <% for (let r = 0; r < 2; r++) { %><% t('marquee').forEach((w) => { %><span><%= w %></span><% }) %><% } %>
  </div>
</div>

<section class="section" id="services">
  <div class="container">
    <div class="section-head">
      <div>
        <span class="eyebrow"><%= t('services.eyebrow') %></span>
        <h2><%= t('services.title') %></h2>
      </div>
      <p><%= t('services.lead') %></p>
    </div>
    <div class="feature-grid">
      <% [['f1', 'drop'], ['f2', 'sparkle'], ['f3', 'shield']].forEach(([k, icon], i) => { %>
        <article class="feature">
          <span class="num">0<%= i + 1 %></span>
          <div class="icon"><%- include('partials/icon', { name: icon, size: 24 }) %></div>
          <h3><%= t(k + '.title') %></h3>
          <p><%= t(k + '.text') %></p>
        </article>
      <% }) %>
    </div>
  </div>
</section>

<section class="section section-dark">
  <div class="container">
    <div class="section-head">
      <div>
        <span class="eyebrow" style="color:var(--sky)"><%= t('why.eyebrow') %></span>
        <h2><%= t('why.title') %></h2>
      </div>
      <p class="muted"><%= t('why.lead') %></p>
    </div>
    <div class="stats-row">
      <div><strong><%= priceList.types.length %></strong><span class="muted"><%= t('why.s1') %></span></div>
      <div><strong><%= priceList.packages.length %></strong><span class="muted"><%= t('why.s2') %></span></div>
      <div><strong>~25m</strong><span class="muted"><%= t('why.s3') %></span></div>
      <div><strong>100%</strong><span class="muted"><%= t('why.s4') %></span></div>
    </div>
  </div>
</section>

<section class="section" id="pricing">
  <div class="container">
    <div class="section-head">
      <div>
        <span class="eyebrow"><%= t('pricing.eyebrow') %></span>
        <h2><%= t('pricing.title') %></h2>
      </div>
      <p><%= t('pricing.lead') %></p>
    </div>
    <p class="scroll-hint"><%= t('pricing.swipe') %></p>
    <div class="price-table-wrap">
      <table class="price-table">
        <thead>
          <tr>
            <th scope="col"><%= t('pricing.package') %></th>
            <% priceList.types.forEach((vt) => { %><th scope="col"><%= L(vt) %></th><% }) %>
          </tr>
        </thead>
        <tbody>
          <% priceList.packages.forEach((p) => { %>
            <tr>
              <th scope="row"><%= L(p) %><% if (L(p, 'description')) { %><small><%= L(p, 'description') %></small><% } %></th>
              <% priceList.types.forEach((vt) => { const price = priceList.prices[p.id + ':' + vt.id]; %>
                <td><%= price != null ? rupiah(price) : '—' %></td>
              <% }) %>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% if (priceList.addons.length) { %>
      <div class="addon-chips" aria-label="<%= t('pricing.addons') %>">
        <% priceList.addons.forEach((a) => { %><span>+ <%= L(a) %><b><%= rupiah(a.price) %></b></span><% }) %>
      </div>
    <% } %>
  </div>
</section>

<section class="section section-sky" id="how">
  <div class="container">
    <div class="section-head">
      <div>
        <span class="eyebrow"><%= t('how.eyebrow') %></span>
        <h2><%= t('how.title') %></h2>
      </div>
    </div>
    <ol class="steps">
      <% [1, 2, 3, 4].forEach((n) => { %>
        <li><h3><%= t('how.' + n + 't') %></h3><p class="muted"><%- t('how.' + n) %></p></li>
      <% }) %>
    </ol>
  </div>
</section>

<section class="section" id="status">
  <div class="container">
    <div class="status-box">
      <div>
        <span class="eyebrow"><%= t('statusBox.eyebrow') %></span>
        <h2 style="margin-top:16px"><%= t('statusBox.title') %></h2>
        <p class="muted" style="margin:0"><%= t('statusBox.lead') %></p>
      </div>
      <form class="inline-form" method="get" action="/status">
        <label class="sr-only" for="plate"><%= t('new.plate') %></label>
        <input class="plate-input" id="plate" type="text" name="plate" placeholder="B 1234 XYZ" required maxlength="15" autocomplete="off">
        <button class="btn btn-lg" type="submit"><%= t('statusBox.check') %> <span class="arrow">→</span></button>
      </form>
    </div>
  </div>
</section>

<footer class="site-footer">
  <div class="container">
    <div>
      <%- include('partials/brand') %>
      <p style="margin-top:12px;max-width:360px"><%= t('footer.tagline') %></p>
    </div>
    <div class="small">
      <p>© <%= new Date().getFullYear() %> <%= businessName %></p>
      <p><a href="/login"><%= t('site.staffLogin') %></a></p>
      <%- include('partials/lang-switch', { dark: true }) %>
    </div>
  </div>
</footer>
</body>
</html>
