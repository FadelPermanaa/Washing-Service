<%- include('partials/head') %>
<%- include('partials/site-nav', { back: true }) %>
<section class="section">
  <div class="container" style="max-width:720px">
    <%- include('partials/flash') %>
    <% if (isNew) { %>
      <div class="notice notice-ok" role="status">
        <strong><%= b.status === 'pending' ? t('book.receivedPending') : t('book.receivedConfirmed') %></strong>
        <span><%= t('book.saveLink') %></span>
      </div>
    <% } %>
    <span class="eyebrow"><%= t('book.eyebrow') %> · <%= b.code %></span>
    <h1 class="page-title"><%= new Date(b.date + 'T00:00:00').toLocaleDateString(locale, { weekday: 'long', day: 'numeric', month: 'long' }) %>, <%= b.start_time %></h1>
    <p><span class="badge badge-booking-<%= b.status %>"><%= t('booking.status.' + b.status) %></span></p>

    <div class="card">
      <dl class="detail-list">
        <dt><%= t('new.plate') %></dt><dd><span class="plate plate-lg"><%= b.plate %></span></dd>
        <dt><%= t('sum.package') %></dt><dd><%= L(b, 'package_name') %> · <%= L(b, 'vehicle_type_name') %></dd>
        <% if (b.addons.length) { %><dt><%= t('sum.addons') %></dt><dd><%= b.addons.map((a) => L(a)).join(', ') %></dd><% } %>
        <dt><%= t('book.time') %></dt><dd><%= b.start_time %>–<%= b.end_time %></dd>
        <dt><%= t('book.estimate') %></dt><dd><strong><%= rupiah(b.price_estimate) %></strong> <span class="small muted"><%= t('book.payAtShop') %></span></dd>
        <dt><%= t('new.customer') %></dt><dd><%= b.customer_name %> · +<%= b.phone %></dd>
        <% if (b.notes) { %><dt><%= t('new.notes') %></dt><dd><%= b.notes %></dd><% } %>
      </dl>
    </div>

    <% if (b.status === 'checked_in' && b.tx_token) { %>
      <div class="card"><p style="margin:0"><%= t('book.arrived') %></p><p style="margin:12px 0 0"><a class="btn" href="/t/<%= b.tx_token %>"><%= t('track.open') %> <span class="arrow">→</span></a></p></div>
    <% } %>

    <div class="card">
      <p class="small muted" style="margin:0 0 12px"><%= t('book.linkHint') %></p>
      <div class="actions-row">
        <% if (shop.business_phone) { %><a class="btn btn-ghost" href="https://wa.me/<%= shop.business_phone %>" target="_blank" rel="noopener"><%= t('book.contact') %></a><% } %>
        <% if (canCancel) { %>
          <form method="post" action="/b/<%= b.token %>/cancel" data-confirm="<%= t('book.cancelConfirm') %>"><%- include('partials/csrf') %>
            <button class="btn btn-danger" type="submit"><%= t('book.cancel') %></button>
          </form>
        <% } %>
      </div>
    </div>
  </div>
</section>
<%- include('partials/site-footer') %>
<script src="/js/app.js"></script>
</body>
</html>
