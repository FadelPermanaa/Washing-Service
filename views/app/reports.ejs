<%- include('../partials/app-start') %>
<% const r = report; const [y, m] = r.month.split('-').map(Number); const daysInMonth = new Date(y, m, 0).getDate();
   const dayMap = Object.fromEntries(r.byDay.map((d) => [Number(d.day.slice(8)), d]));
   const maxRev = Math.max(1, ...r.byDay.map((d) => d.revenue));
   const maxPkg = Math.max(1, ...r.byPackage.map((p) => p.revenue));
   const maxType = Math.max(1, ...r.byType.map((p) => p.count)); %>
<div class="topbar">
  <div><h1><%= t('rep.title') %></h1><div class="sub"><%= new Date(y, m - 1, 1).toLocaleDateString(locale, { month: 'long', year: 'numeric' }) %></div></div>
  <form class="actions" method="get"><input type="month" name="month" value="<%= r.month %>" aria-label="<%= t('rep.month') %>"><button class="btn" type="submit"><%= t('rep.show') %></button></form>
</div>
<div class="kpis">
  <div class="kpi k-dark"><div class="label"><%= t('rep.revenue') %></div><div class="value mono"><%= rupiah(r.totals.revenue) %></div></div>
  <div class="kpi k-vanilla"><div class="label"><%= t('rep.vehicles') %></div><div class="value mono"><%= r.totals.vehicles %></div></div>
  <div class="kpi k-sky"><div class="label"><%= t('rep.average') %></div><div class="value mono"><%= rupiah(r.totals.vehicles ? Math.round(r.totals.revenue / r.totals.vehicles) : 0) %></div></div>
  <div class="kpi"><div class="label"><%= t('rep.activeDays') %></div><div class="value mono"><%= r.byDay.length %></div></div>
</div>
<div class="card">
  <h2><%= t('rep.daily') %></h2>
  <div class="bars" role="img" aria-label="<%= t('rep.chartAria') %>">
    <% for (let d = 1; d <= daysInMonth; d++) { const row = dayMap[d]; const h = row ? Math.max(2, Math.round(row.revenue / maxRev * 100)) : 0; %>
      <div class="bar" style="height:<%= h %>%"><span><%= d %>: <%= row ? rupiah(row.revenue) + ' · ' + row.vehicles + ' ' + t('rep.veh') : t('rep.noSales') %></span></div>
    <% } %>
  </div>
  <div class="bars-axis"><span>1</span><span><%= Math.ceil(daysInMonth / 2) %></span><span><%= daysInMonth %></span></div>
</div>
<div class="grid-2-even" style="margin-top:18px">
  <div class="card">
    <h2><%= t('rep.byPackage') %></h2>
    <% if (!r.byPackage.length) { %><div class="empty"><%= t('rep.noData') %></div><% } %>
    <% r.byPackage.forEach((p) => { %>
      <div style="margin-bottom:14px"><div class="card-head" style="margin:0"><span><%= L(p) %> <span class="muted small">× <%= p.count %></span></span><strong class="mono"><%= rupiah(p.revenue) %></strong></div><div class="meter"><i style="width:<%= Math.round(p.revenue / maxPkg * 100) %>%"></i></div></div>
    <% }) %>
  </div>
  <div class="card">
    <h2><%= t('rep.byType') %></h2>
    <% if (!r.byType.length) { %><div class="empty"><%= t('rep.noData') %></div><% } %>
    <% r.byType.forEach((p) => { %>
      <div style="margin-bottom:14px"><div class="card-head" style="margin:0"><span><%= L(p) %></span><strong class="mono"><%= p.count %></strong></div><div class="meter"><i style="width:<%= Math.round(p.count / maxType * 100) %>%;background:var(--sky)"></i></div></div>
    <% }) %>
    <h2 style="margin-top:22px"><%= t('rep.byMethod') %></h2>
    <table class="data"><tbody>
      <% if (!r.byMethod.length) { %><tr><td class="empty"><%= t('rep.noPayments') %></td></tr><% } %>
      <% r.byMethod.forEach((p) => { %><tr><td><%= t('method.' + p.name) %></td><td class="num"><%= p.count %>×</td><td class="num"><%= rupiah(p.revenue) %></td></tr><% }) %>
    </tbody></table>
  </div>
</div>
<div class="card" style="margin-top:18px">
  <h2><%= t('rep.byWasher') %></h2>
  <div class="table-wrap">
    <table class="data stack">
      <thead><tr><th><%= t('work.washer') %></th><th class="num"><%= t('rep.cars') %></th><th class="num"><%= t('rep.avgTime') %></th><th class="num"><%= t('rep.revenue') %></th><th class="num"><%= t('work.commission') %></th></tr></thead>
      <tbody>
        <% if (!r.byWasher.length) { %><tr><td colspan="5" class="empty"><%= t('rep.noData') %></td></tr><% } %>
        <% r.byWasher.forEach((w) => { %>
          <tr>
            <td data-label="<%= t('work.washer') %>"><strong><%= w.name %></strong></td>
            <td data-label="<%= t('rep.cars') %>" class="num"><%= w.count %></td>
            <td data-label="<%= t('rep.avgTime') %>" class="num"><%= w.avg_minutes != null ? t('rep.minutes', { n: w.avg_minutes }) : '—' %></td>
            <td data-label="<%= t('rep.revenue') %>" class="num nowrap"><%= rupiah(w.revenue) %></td>
            <td data-label="<%= t('work.commission') %>" class="num nowrap"><strong><%= rupiah(w.commission) %></strong></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
<%- include('../partials/app-end') %>
