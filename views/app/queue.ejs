<%- include('../partials/app-start') %>
<div class="topbar">
  <div><h1><%= t('queue.title') %></h1><div class="sub"><%= t('queue.sub') %></div></div>
  <div class="actions"><a class="btn" href="/app/transactions/new"><%- include('../partials/icon', { name: 'plus' }) %> <%= t('btn.newWash') %></a></div>
</div>
<div class="board" data-autorefresh="30">
  <% [['waiting', t('status.waiting')], ['washing', t('status.washing')], ['done', t('queue.doneToday')]].forEach(([key, label]) => { %>
    <section class="lane l-<%= key %>" aria-label="<%= label %>">
      <div class="lane-head"><span><%= label %></span><span class="count"><%= queue[key].length %></span></div>
      <% if (!queue[key].length) { %><div class="empty"><%= t('queue.empty') %></div><% } %>
      <% queue[key].forEach((r) => { %><%- include('../partials/ticket', { t: r, methods, washers, bays, progress }) %><% }) %>
    </section>
  <% }) %>
</div>
<%- include('../partials/app-end') %>
