<%- include('../partials/app-start') %>
<div class="topbar">
  <div><h1>Transactions</h1><div class="sub"><%= rows.length %> result<%= rows.length === 1 ? '' : 's' %><%= rows.length === 300 ? ' (showing latest 300)' : '' %></div></div>
  <div class="actions"><a class="btn" href="/app/transactions/new"><%- include('../partials/icon', { name: 'plus' }) %> New wash</a></div>
</div>
<div class="card">
  <form class="filters" method="get">
    <input type="search" name="q" value="<%= filters.q %>" placeholder="Search plate, ticket or customer" aria-label="Search">
    <input type="date" name="date" value="<%= filters.date %>" aria-label="Date">
    <select name="status" aria-label="Status">
      <option value="">All statuses</option>
      <% [['waiting','Waiting'],['washing','Washing'],['done','Done'],['cancelled','Cancelled'],['unpaid','Unpaid']].forEach(([v, l]) => { %>
        <option value="<%= v %>"<%= filters.status === v ? ' selected' : '' %>><%= l %></option>
      <% }) %>
    </select>
    <button class="btn" type="submit">Filter</button>
    <a class="btn btn-ghost" href="/app/transactions?date=all">All dates</a>
  </form>
  <div class="table-wrap">
    <table class="data stack">
      <thead><tr><th>Ticket</th><th>Date</th><th>Plate</th><th>Customer</th><th>Package</th><th>Status</th><th>Payment</th><th class="num">Total</th></tr></thead>
      <tbody>
        <% if (!rows.length) { %><tr><td colspan="8" class="empty">No transactions match these filters.</td></tr><% } %>
        <% rows.forEach((t) => { %>
          <tr>
            <td data-label="Ticket"><a class="row-link" href="/app/transactions/<%= t.id %>"><%= t.code %></a></td>
            <td data-label="Date" class="mono nowrap"><%= t.created_at.slice(0, 16) %></td>
            <td data-label="Plate"><span class="plate"><%= t.plate %></span></td>
            <td data-label="Customer"><%= t.customer_name || '—' %></td>
            <td data-label="Package"><%= t.package_name %><div class="small muted"><%= t.vehicle_type_name %></div></td>
            <td data-label="Status"><span class="badge badge-<%= t.status %>"><%= t.status %></span></td>
            <td data-label="Payment"><span class="badge badge-<%= t.payment_status %>"><%= t.payment_status %></span><% if (t.payment_method) { %><div class="small muted"><%= t.payment_method %></div><% } %></td>
            <td data-label="Total" class="num nowrap"><%= rupiah(t.total) %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
<%- include('../partials/app-end') %>
