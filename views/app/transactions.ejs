<%- include('../partials/app-start') %>
<div class="topbar">
  <div><h1><%= t('tx.title') %></h1><div class="sub"><%= t('tx.results', { n: rows.length }) %><%= rows.length === 300 ? t('tx.latest') : '' %></div></div>
  <div class="actions"><a class="btn" href="/app/transactions/new"><%- include('../partials/icon', { name: 'plus' }) %> <%= t('btn.newWash') %></a></div>
</div>
<div class="card">
  <form class="filters" method="get">
    <input type="search" name="q" value="<%= filters.q %>" placeholder="<%= t('tx.searchPh') %>" aria-label="<%= t('btn.search') %>">
    <input type="date" name="date" value="<%= filters.date %>" aria-label="<%= t('col.date') %>">
    <select name="status" aria-label="<%= t('col.status') %>">
      <option value=""><%= t('tx.allStatuses') %></option>
      <% [['waiting', 'status.waiting'], ['washing', 'status.washing'], ['done', 'status.done'], ['cancelled', 'status.cancelled'], ['unpaid', 'pay.unpaid']].forEach(([v, k]) => { %>
        <option value="<%= v %>"<%= filters.status === v ? ' selected' : '' %>><%= t(k) %></option>
      <% }) %>
    </select>
    <button class="btn" type="submit"><%= t('btn.filter') %></button>
    <a class="btn btn-ghost" href="/app/transactions?date=all"><%= t('tx.allDates') %></a>
  </form>
  <div class="table-wrap">
    <table class="data stack">
      <thead><tr><th><%= t('col.ticket') %></th><th><%= t('col.date') %></th><th><%= t('col.plate') %></th><th><%= t('col.customer') %></th><th><%= t('col.package') %></th><th><%= t('col.status') %></th><th><%= t('col.payment') %></th><th class="num"><%= t('col.total') %></th></tr></thead>
      <tbody>
        <% if (!rows.length) { %><tr><td colspan="8" class="empty"><%= t('tx.none') %></td></tr><% } %>
        <% rows.forEach((r) => { %>
          <tr>
            <td data-label="<%= t('col.ticket') %>"><a class="row-link" href="/app/transactions/<%= r.id %>"><%= r.code %></a></td>
            <td data-label="<%= t('col.date') %>" class="mono nowrap"><%= r.created_at.slice(0, 16) %></td>
            <td data-label="<%= t('col.plate') %>"><span class="plate"><%= r.plate %></span></td>
            <td data-label="<%= t('col.customer') %>"><%= r.customer_name || '—' %></td>
            <td data-label="<%= t('col.package') %>"><%= L(r, 'package_name') %><div class="small muted"><%= L(r, 'vehicle_type_name') %></div></td>
            <td data-label="<%= t('col.status') %>"><span class="badge badge-<%= r.status %>"><%= t('status.' + r.status) %></span></td>
            <td data-label="<%= t('col.payment') %>"><span class="badge badge-<%= r.payment_status %>"><%= t('pay.' + r.payment_status) %></span><% if (r.payment_method) { %><div class="small muted"><%= t('method.' + r.payment_method) %></div><% } %></td>
            <td data-label="<%= t('col.total') %>" class="num nowrap"><%= rupiah(r.total) %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
<%- include('../partials/app-end') %>
