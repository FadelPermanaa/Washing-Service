<%- include('../partials/app-start') %>
<% const { types, packages, addons, prices } = priceList; %>
<div class="topbar">
  <div><h1><%= t('prices.title') %></h1><div class="sub"><%= t('prices.sub') %></div></div>
</div>
<form class="card" method="post" action="/app/prices">
  <%- include('../partials/csrf') %>
  <div class="card-head"><h2><%= t('prices.grid') %></h2><button class="btn" type="submit"><%= t('prices.save') %></button></div>
  <div class="table-wrap">
    <table class="data">
      <thead><tr><th><%= t('col.package') %></th><% types.forEach((vt) => { %><th class="num<%= vt.active ? '' : ' inactive' %>"><%= L(vt) %></th><% }) %></tr></thead>
      <tbody>
        <% packages.forEach((p) => { %>
          <tr class="<%= p.active ? '' : 'inactive' %>">
            <td><strong><%= L(p) %></strong><div class="small muted"><%= L(p, 'description') %></div></td>
            <% types.forEach((vt) => { const v = prices[p.id + ':' + vt.id]; %>
              <td class="num"><input class="price-input" type="number" min="0" step="500" name="price_<%= p.id %>_<%= vt.id %>" value="<%= v ?? '' %>" aria-label="<%= L(p) %> — <%= L(vt) %>" inputmode="numeric"></td>
            <% }) %>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</form>

<p class="small muted" style="margin:14px 2px 0"><%= t('prices.bilingualHint') %></p>

<div class="grid-2-even" style="margin-top:14px">
  <div class="card">
    <h2><%= t('prices.types') %></h2>
    <div class="catalog-list">
      <% types.forEach((vt) => { %>
        <div class="catalog-item<%= vt.active ? '' : ' inactive' %>">
          <div class="catalog-row">
            <div><strong><%= vt.name %></strong><% if (vt.name_id) { %><div class="small muted"><%= vt.name_id %></div><% } %></div>
            <form method="post" action="/app/catalog/vehicle-types/<%= vt.id %>/toggle"><%- include('../partials/csrf') %><button class="btn btn-sm btn-ghost" type="submit"><%= vt.active ? t('prices.hide') : t('prices.show') %></button></form>
          </div>
          <%- include('../partials/names-form', { kind: 'vehicle-types', item: vt }) %>
        </div>
      <% }) %>
    </div>
    <form method="post" action="/app/catalog/vehicle-types" class="add-form">
      <%- include('../partials/csrf') %>
      <div class="field-row">
        <input type="text" name="name" placeholder="<%= t('prices.nameEn') %>" required maxlength="60" aria-label="<%= t('prices.nameEn') %>">
        <input type="text" name="name_id" placeholder="<%= t('prices.nameId') %>" maxlength="60" aria-label="<%= t('prices.nameId') %>">
      </div>
      <button class="btn" type="submit"><%= t('prices.add') %></button>
    </form>

    <h2 style="margin-top:28px"><%= t('prices.packages') %></h2>
    <div class="catalog-list">
      <% packages.forEach((p) => { %>
        <div class="catalog-item<%= p.active ? '' : ' inactive' %>">
          <div class="catalog-row">
            <div><strong><%= p.name %></strong><% if (p.name_id) { %><div class="small muted"><%= p.name_id %></div><% } %></div>
            <form method="post" action="/app/catalog/packages/<%= p.id %>/toggle"><%- include('../partials/csrf') %><button class="btn btn-sm btn-ghost" type="submit"><%= p.active ? t('prices.hide') : t('prices.show') %></button></form>
          </div>
          <%- include('../partials/names-form', { kind: 'packages', item: p, withDescription: true }) %>
        </div>
      <% }) %>
    </div>
    <form method="post" action="/app/catalog/packages" class="add-form">
      <%- include('../partials/csrf') %>
      <div class="field-row">
        <input type="text" name="name" placeholder="<%= t('prices.nameEn') %>" required maxlength="60" aria-label="<%= t('prices.nameEn') %>">
        <input type="text" name="name_id" placeholder="<%= t('prices.nameId') %>" maxlength="60" aria-label="<%= t('prices.nameId') %>">
      </div>
      <div class="field-row">
        <input type="text" name="description" placeholder="<%= t('prices.descEn') %>" maxlength="160" aria-label="<%= t('prices.descEn') %>">
        <input type="text" name="description_id" placeholder="<%= t('prices.descId') %>" maxlength="160" aria-label="<%= t('prices.descId') %>">
      </div>
      <button class="btn" type="submit"><%= t('prices.addPackage') %></button>
      <p class="small muted" style="margin:8px 0 0"><%= t('prices.afterAdd') %></p>
    </form>
  </div>

  <div class="card">
    <h2><%= t('prices.addons') %></h2>
    <div class="catalog-list">
      <% addons.forEach((a) => { %>
        <div class="catalog-item<%= a.active ? '' : ' inactive' %>">
          <div class="catalog-row">
            <div><strong><%= a.name %></strong><% if (a.name_id) { %><div class="small muted"><%= a.name_id %></div><% } %></div>
            <div class="catalog-actions">
              <form class="inline" method="post" action="/app/catalog/addons/<%= a.id %>/price">
                <%- include('../partials/csrf') %>
                <input class="price-input" type="number" min="0" step="500" name="price" value="<%= a.price %>" aria-label="<%= t('prices.price') %> — <%= L(a) %>">
                <button class="btn btn-sm" type="submit"><%= t('prices.saveOne') %></button>
              </form>
              <form method="post" action="/app/catalog/addons/<%= a.id %>/toggle"><%- include('../partials/csrf') %><button class="btn btn-sm btn-ghost" type="submit"><%= a.active ? t('prices.hide') : t('prices.show') %></button></form>
            </div>
          </div>
          <%- include('../partials/names-form', { kind: 'addons', item: a }) %>
        </div>
      <% }) %>
    </div>
    <form method="post" action="/app/catalog/addons" class="add-form">
      <%- include('../partials/csrf') %>
      <div class="field-row">
        <input type="text" name="name" placeholder="<%= t('prices.nameEn') %>" required maxlength="60" aria-label="<%= t('prices.nameEn') %>">
        <input type="text" name="name_id" placeholder="<%= t('prices.nameId') %>" maxlength="60" aria-label="<%= t('prices.nameId') %>">
      </div>
      <div class="filters" style="margin:10px 0 0">
        <input class="price-input" type="number" name="price" min="0" step="500" placeholder="<%= t('prices.price') %>" required aria-label="<%= t('prices.price') %>">
        <button class="btn" type="submit"><%= t('prices.add') %></button>
      </div>
    </form>
  </div>
</div>
<%- include('../partials/app-end') %>
