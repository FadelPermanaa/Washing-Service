<%- include('partials/head') %>
<%- include('partials/site-nav', { back: true }) %>
<section class="section">
  <div class="container" style="max-width:720px">
    <span class="eyebrow"><%= t('statusBox.eyebrow') %></span>
    <h1 style="font-size:clamp(32px,5vw,52px);margin-top:16px"><%= t('status.heading') %></h1>
    <form class="inline-form" method="get" action="/status" style="margin:24px 0 36px">
      <input class="plate-input" type="text" name="plate" value="<%= plate %>" placeholder="B 1234 XYZ" aria-label="<%= t('new.plate') %>" required maxlength="15" autocomplete="off">
      <button class="btn btn-lg" type="submit"><%= t('statusBox.check') %></button>
    </form>

    <% if (results) { %>
      <% if (!results.length) { %>
        <div class="card empty"><%= t('status.none1') %> <span class="plate"><%= plate %></span>.<br><%= t('status.none2') %></div>
      <% } %>
      <% results.forEach((r) => { const idx = { waiting: 1, washing: 2, done: 3 }[r.status]; %>
        <div class="card">
          <div class="card-head">
            <span class="plate plate-lg"><%= plate %></span>
            <span class="badge badge-<%= r.status %>"><%= r.status === 'done' ? t('status.ready') : t('status.' + r.status) %></span>
          </div>
          <p class="muted" style="margin-bottom:6px"><%= L(r, 'package_name') %> · <%= t('status.ticket') %> <%= r.code %></p>
          <div class="timeline">
            <div class="<%= idx >= 1 ? 'on' : '' %>"><%= t('timeline.received') %><br><%= time(r.created_at) %></div>
            <div class="<%= idx >= 2 ? 'on' : '' %>"><%= t('timeline.washing') %><br><%= time(r.started_at) %></div>
            <div class="<%= idx >= 3 ? 'on' : '' %>"><%= t('timeline.ready') %><br><%= time(r.finished_at) %></div>
          </div>
        </div>
      <% }) %>
    <% } %>
  </div>
</section>
</body>
</html>
