<%- include('head') %>
<% const nav = [
  [t('nav.workspace'), [['/app', t('nav.dashboard'), 'dashboard'], ['/app/transactions/new', t('nav.new'), 'plus'], ['/app/queue', t('nav.queue'), 'queue'], ['/app/transactions', t('nav.transactions'), 'list'], ['/app/vehicles', t('nav.vehicles'), 'car'], ['/app/reports', t('nav.reports'), 'chart']]],
  ...(user.role === 'admin' ? [[t('nav.admin'), [['/app/prices', t('nav.prices'), 'tag'], ['/app/users', t('nav.staff'), 'users']]]] : []),
];
const fullPath = path.replace(/\/$/, '') || '/';
const isActive = (href) => href === '/app' ? fullPath === '/app' : (href === '/app/transactions' ? fullPath === href || /^\/app\/transactions\/\d+/.test(fullPath) : fullPath.startsWith(href)); %>
<div class="mobile-bar">
  <%- include('brand', { href: '/app' }) %>
  <div class="right">
    <%- include('lang-switch', { dark: true }) %>
    <button type="button" data-toggle-sidebar aria-label="<%= t('nav.openMenu') %>"><%- include('icon', { name: 'menu' }) %></button>
  </div>
</div>
<div class="app-shell">
  <aside class="sidebar" id="sidebar">
    <%- include('brand', { href: '/app' }) %>
    <nav>
      <% nav.forEach(([label, items]) => { %>
        <div class="nav-label"><%= label %></div>
        <% items.forEach(([href, text, icon]) => { %>
          <a class="nav<%= isActive(href) ? ' active' : '' %>" href="<%= href %>"<%- isActive(href) ? ' aria-current="page"' : '' %>><%- include('icon', { name: icon }) %><%= text %></a>
        <% }) %>
      <% }) %>
    </nav>
    <div class="me">
      <%- include('lang-switch', { dark: true }) %>
      <strong><%= user.name %></strong>
      <span class="small"><%= t('role.' + user.role) %> · @<%= user.username %></span>
      <form method="post" action="/logout"><%- include('csrf') %><button class="btn btn-sm btn-block" type="submit"><%= t('nav.logout') %></button></form>
    </div>
  </aside>
  <main class="main">
    <%- include('flash') %>
