<div class="ticket">
  <div class="ticket-top">
    <span class="plate"><%= t.plate %></span>
    <span class="badge badge-<%= t.payment_status %>"><%= tr('pay.' + t.payment_status) %></span>
  </div>
  <div class="meta">
    <b><%= L(t, 'package_name') %></b> · <%= L(t, 'vehicle_type_name') %><br>
    <%= t.customer_name || tr('ticket.walkin') %><%= t.brand_model ? ' · ' + t.brand_model : '' %><br>
    <a class="row-link" href="/app/transactions/<%= t.id %>"><%= t.code %></a> · <%= tr('ticket.in') %> <%= time(t.created_at) %><% if (t.started_at) { %> · <%= tr('ticket.start') %> <%= time(t.started_at) %><% } %><% if (t.finished_at) { %> · <%= tr('ticket.done') %> <%= time(t.finished_at) %><% } %> · <b><%= rupiah(t.total) %></b>
  </div>
  <% if (locals.actions !== false) { %>
  <div class="ticket-actions">
    <% if (t.status === 'waiting') { %>
      <form method="post" action="/app/transactions/<%= t.id %>/status"><input type="hidden" name="action" value="start"><button class="btn btn-sm" type="submit"><%= tr('action.start') %></button></form>
    <% } else if (t.status === 'washing') { %>
      <form method="post" action="/app/transactions/<%= t.id %>/status"><input type="hidden" name="action" value="finish"><button class="btn btn-sm btn-sky" type="submit"><%= tr('action.finish') %></button></form>
    <% } %>
    <% if (t.payment_status === 'unpaid') { %>
      <form method="post" action="/app/transactions/<%= t.id %>/pay">
        <select name="method" aria-label="<%= tr('field.paymentMethod') %>"><% methods.forEach((m) => { %><option value="<%= m %>"><%= tr('method.' + m) %></option><% }) %></select>
        <button class="btn btn-sm btn-vanilla" type="submit"><%= tr('action.pay') %></button>
      </form>
    <% } %>
  </div>
  <% } %>
</div>
